# Postgres connection string (Neon, Supabase, Vercel Postgres… any Postgres).
DATABASE_URL="postgresql://user:password@host:5432/helios?sslmode=require"

# Signs login cookies. Any long random string:  openssl rand -hex 32
AUTH_SECRET=""

# Photo storage on Vercel: create a Blob store (Storage → Create → Blob) and
# this is added for you. Leave empty locally to store photos in ./storage.
BLOB_READ_WRITE_TOKEN=""

# First admin, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Set to false to skip the 3 demo slabs when seeding an empty library.
SEED_DEMO="true"
