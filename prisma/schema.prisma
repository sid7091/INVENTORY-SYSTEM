// Eagle Stone — Phase 1 inventory data model (block-level tracking).
// SQLite keeps Phase 1 zero-config; the schema is written to port cleanly to
// Postgres later (enums are modelled as validated strings so SQLite is happy).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff / auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Legacy coarse role, kept as a fallback for accounts created before the
  // Role table existed: STAFF | ADMIN. New accounts always get a roleId.
  role         String   @default("STAFF")
  roleId       String?
  roleRef      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  auditLogs    AuditLog[]
  photoBatches PhotoBatch[]
}

// Configurable roles. Worker / Staff / Admin ship as presets (isPreset), and
// admins can create their own with any mix of capabilities. `permissions` is
// a JSON array of capability keys (see src/lib/permissions.ts). `uiMode`
// decides which experience the user lands in: "simple" is the icon-first
// factory-floor UI, "full" is the complete management app.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String // JSON array of capability keys
  uiMode      String   @default("full") // full | simple
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users User[]
}

// ---------------------------------------------------------------------------
// Blocks — the core inventory unit
// ---------------------------------------------------------------------------

model Block {
  id String @id @default(cuid())

  // Identity (matches Ready_to_dispatch.xlsx column layout)
  blockNo   String  @unique // e.g. ANW-M543
  quarryNo  String? // e.g. HSS-105
  colour    String // COLOUR / variety
  exporter  String? // EXPORTER NAME
  quarry    String? // QUARRY NAME (source quarry site)
  warehouse String? // physical warehouse / yard location

  // Measurements
  weightTons  Float? // WEIGHT (Tons)
  lengthCm    Float? // Length (CM)
  heightCm    Float? // Height (CM)
  pcs         Int? // PCS (slab count)
  endPcs      Int? // END PCS
  totalSft    Float? // Total Quantity (SFT)
  thicknessMm Float? // normalised thickness in millimetres (e.g. 18)

  // Business classification (last spreadsheet column) + workflow status
  category String @default("HELIOS_LISTED") // see CATEGORY constants
  status   String @default("NEEDS_PHOTOS") // NEEDS_PHOTOS | IN_STOCK | READY_TO_DISPATCH | HOLD | PARTIALLY_SOLD | SOLD

  // Bulletproofing
  version   Int       @default(1) // optimistic concurrency token
  deletedAt DateTime? // soft delete (30-day trash)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slabs       Slab[]
  photos      Photo[]
  auditLogs   AuditLog[]
  allocations PieceAllocation[]
  actionItems ActionItem[]

  @@index([status])
  @@index([colour])
  @@index([exporter])
  @@index([quarry])
  @@index([deletedAt])
}

// Piece-level allocation: a contiguous range of slab pieces (1..pcs) that has
// been SOLD or put on HOLD out of a block. Available pieces are the complement
// of all allocations. Enables partial sales ("sold 20–30 of 46").
model PieceAllocation {
  id        String   @id @default(cuid())
  blockId   String
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  fromPiece Int
  toPiece   Int
  kind      String // SOLD | HOLD
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([blockId])
}

// Optional per-slab child records for premium blocks
model Slab {
  id          String   @id @default(cuid())
  blockId     String
  block       Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  slabNo      String // label within the block, e.g. "01"
  lengthCm    Float?
  heightCm    Float?
  thicknessMm Float?
  sft         Float?
  status      String   @default("IN_STOCK")
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([blockId, slabNo])
  @@index([blockId])
}

// ---------------------------------------------------------------------------
// Photos + the photo gate
// ---------------------------------------------------------------------------

model Photo {
  id        String   @id @default(cuid())
  blockId   String
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  url       String // public path, e.g. /uploads/xxx.jpg
  filename  String // original filename
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([blockId])
}

// ---------------------------------------------------------------------------
// Bulk Photo Upload Room — nothing commits until approved
// ---------------------------------------------------------------------------

model PhotoBatch {
  id        String   @id @default(cuid())
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id])
  status    String   @default("REVIEW") // REVIEW | COMMITTED | DISCARDED
  createdAt DateTime @default(now())

  items PhotoBatchItem[]
}

model PhotoBatchItem {
  id           String   @id @default(cuid())
  batchId      String
  batch        PhotoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  filename     String // original filename
  tempUrl      String // staged file path in /uploads/_staging
  // Auto-match result
  guessBlockNo String? // block number parsed from the filename
  matchedBlockId String? // resolved Block id, if any
  // Reviewer decision: PENDING | APPROVE | SKIP | REJECT | REASSIGN
  decision     String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Audit log — who / when / what / why on every change
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  blockId   String? // null for non-block events (login, import, etc.)
  block     Block?   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE | UPDATE | STATUS_CHANGE | DELETE | RESTORE | PHOTO_ADD | IMPORT | ...
  reason    String? // mandatory for status changes
  // JSON string snapshot of what changed { field: {from, to} }
  changes   String?
  createdAt DateTime @default(now())

  @@index([blockId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// App settings — small key/value store (e.g. the Google Drive folder link).
// Configuration, not inventory data — the admin "Clear All Data" reset must
// NOT wipe this.
// ---------------------------------------------------------------------------

model AppSetting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Needs Actions — a generalised inbox. A block sitting in the NEEDS_PHOTOS
// gate is one kind of "needs action" (handled via Block.status, unchanged);
// this table covers every other kind, chiefly Google Drive folders the
// automatic sync couldn't confidently match to a block.
// ---------------------------------------------------------------------------

model ActionItem {
  id     String  @id @default(cuid())
  blockId String? // set once resolved to a specific block; null while unmatched
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  type    String // DRIVE_UNMATCHED | DRIVE_AMBIGUOUS | GENERAL
  message String // human-readable: what's being asked

  // Drive context, so a re-sync can find and update (not duplicate) this entry.
  driveFolderId   String?
  driveFolderName String?
  images          String? // JSON array of {fileId, name} preview images from Drive

  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([blockId])
  @@index([status])
  @@index([driveFolderId])
}

// Tracks every Google Drive file already imported as a Photo, so the
// automatic sync never re-imports (or duplicates) the same photo twice.
model DriveImportedFile {
  id          String   @id @default(cuid())
  driveFileId String   @unique
  blockId     String?
  photoId     String?
  createdAt   DateTime @default(now())
}
