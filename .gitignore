# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (keep .env.example only — never commit real secrets)
.env
.env*.local

# typescript
*.tsbuildinfo

# prisma / sqlite database + backups (local data, never committed)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*
/backups/

# uploaded photos (runtime data)
/public/uploads/*
!/public/uploads/.gitkeep
