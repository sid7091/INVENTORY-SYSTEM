# Local dev: SQLite (zero-config). For Vercel/production use Postgres and change
# prisma/schema.prisma provider to "postgresql" — see DEPLOY-VERCEL.md.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"

# Set automatically when you create Vercel Blob storage. When present, photos
# are stored in Vercel Blob instead of the local filesystem (required on Vercel).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Signs staff session cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run db:seed`. helios123 is the demo default;
# change SEED_ADMIN_PASSWORD (and re-run db:seed) before any real use.
SEED_ADMIN_EMAIL="admin@eaglestone.com"
SEED_ADMIN_PASSWORD="helios123"

# White-label branding (all optional; defaults to Eagle Stone).
NEXT_PUBLIC_BRAND_NAME="Eagle Stone"
NEXT_PUBLIC_BRAND_SHORT="Eagle"
NEXT_PUBLIC_BRAND_TAGLINE="Block-level marble & stone inventory"
# Square icon mark (sidebar + mobile header) and full wordmark (login page
# hero) — both transparent PNGs. Drop your own into /public to white-label.
# NEXT_PUBLIC_BRAND_LOGO_URL="/eagle-logo.png"
# NEXT_PUBLIC_BRAND_WORDMARK_URL="/eagle-stone-wordmark.png"
