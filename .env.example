DATABASE_URL="file:./dev.db"

# Signs staff session cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run db:seed`. helios123 is the demo default;
# change SEED_ADMIN_PASSWORD (and re-run db:seed) before any real use.
SEED_ADMIN_EMAIL="admin@eaglestone.com"
SEED_ADMIN_PASSWORD="helios123"

# White-label branding (all optional; defaults to Eagle Stone).
NEXT_PUBLIC_BRAND_NAME="Eagle Stone"
NEXT_PUBLIC_BRAND_SHORT="Eagle"
NEXT_PUBLIC_BRAND_TAGLINE="Block-level marble & stone inventory"
